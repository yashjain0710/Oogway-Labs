# Lenny Growth Assistant — local defaults (no secrets here)
# Copy to .env and adjust. Never commit .env.

# --- Database ---
# Local quick-start (no Docker): SQLite file
# Docker/evaluator with Postgres: postgresql+psycopg2://lenny:lenny@db:5432/lenny
DATABASE_URL=sqlite:///./lenny.db

# --- LLM provider toggle ---
# Options: ollama | anthropic | openai | mock
LLM_PROVIDER=ollama
# Active model display name (UI reads this from /api/v1/settings/models)
LLM_MODEL=qwen2.5:3b

# --- Ollama (mandatory local demo) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_S=300
# If Ollama is down the API returns a 503 with start-up instructions.
# Cloud fallback is NEVER silent: set LLM_FALLBACK_ENABLED=true explicitly to allow it.
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=anthropic

# --- Cloud providers (optional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# --- Retrieval ---
RETRIEVAL_TOP_K=5
DATA_DIR=./data/transcripts
INDEX_PATH=./data/index/chunks.json
